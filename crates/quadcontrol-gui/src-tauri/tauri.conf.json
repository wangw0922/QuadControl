{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuadControl",
  "version": "0.1.0",
  "identifier": "com.quadcontrol.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuadControl",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://localhost:* http://127.0.0.1:* http://[::1]:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
